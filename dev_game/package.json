{
  "name": "dev-game-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "factory:skill-drift": "bash ../scripts/check_skill_drift.sh",
    "factory:ui-direction": "node ../scripts/check_ui_direction.mjs",
    "factory:host-preflight": "node generator/scripts/host-preflight.mjs",
    "factory:make": "node generator/scripts/make-game.mjs",
    "factory:validate": "node generator/src/cli.mjs --validate-only --spec generator/examples/poop-dodge.spec.json",
    "factory:dry-run": "node generator/src/cli.mjs --dry-run --spec generator/examples/poop-dodge.spec.json --out generated/poop-dodge-demo",
    "factory:smoke": "node generator/scripts/smoke-generate.mjs",
    "factory:productionize": "node generator/scripts/productionize.mjs",
    "factory:imagegen": "node generator/scripts/codex-imagegen.mjs",
    "factory:asset-qa": "node generator/scripts/asset-qa.mjs",
    "factory:browser-smoke": "node generator/scripts/browser-smoke.mjs",
    "factory:runtime-asset-delivery-test": "node generator/scripts/runtime-asset-delivery-test.mjs",
    "factory:dist-runtime-qa": "node generator/scripts/dist-runtime-qa.mjs",
    "factory:qa": "npm run factory:skill-drift -- --skip-user && npm run factory:skill-gate-controls && npm run factory:skill-task-gate-qa && npm run factory:cli-parity && npm run factory:skill-task-gate-verify && npm run factory:ui-direction && npm run factory:validate && npm run factory:smoke && npm run factory:runtime-asset-delivery-test && npm run factory:asset-qa && npm run factory:imagegen-integrity-qa && npm run factory:browser-smoke && npm run factory:completion-claim-qa && npm run factory:production-pass-receipt-qa && npm run factory:skill-commands",
    "factory:imagegen-integrity-qa": "node generator/scripts/imagegen-integrity-qa.mjs",
    "factory:production-demo-qa": "node generator/scripts/production-demo-qa.mjs",
    "factory:visual-layout-qa": "node generator/scripts/visual-layout-qa.mjs",
    "factory:scene-composite-qa": "node generator/scripts/scene-composite-qa.mjs",
    "factory:image-quality-qa": "node generator/scripts/image-quality-qa.mjs",
    "factory:hq-screen-quality-qa": "node generator/scripts/hq-screen-quality-qa.mjs",
    "factory:captured-state-qa": "node generator/scripts/captured-state-qa.mjs",
    "factory:first-play-clarity-qa": "node generator/scripts/first-play-clarity-qa.mjs",
    "factory:input-hostility-qa": "node generator/scripts/input-hostility-qa.mjs",
    "factory:session-continuity-qa": "node generator/scripts/session-continuity-qa.mjs",
    "factory:docs-runtime-sync-qa": "node generator/scripts/docs-runtime-sync-qa.mjs",
    "factory:qa-session-report": "node generator/scripts/qa-session-report.mjs",
    "factory:migrate-spec-v2": "node generator/scripts/migrate-spec-v2.mjs",
    "factory:production-gate": "node generator/scripts/production-gate.mjs",
    "games:list": "node generator/scripts/run-curated-games.mjs list",
    "games:build": "node generator/scripts/run-curated-games.mjs build",
    "games:dev": "node generator/scripts/run-curated-games.mjs dev",
    "games:smoke": "node generator/scripts/run-curated-games.mjs smoke",
    "factory:play-profile-qa": "node generator/scripts/play-profile-qa.mjs",
    "factory:completion-claim-qa": "node generator/scripts/completion-claim-qa.mjs",
    "factory:skill-commands": "node ../scripts/check_skill_commands.mjs",
    "factory:skill-gate-controls": "node ../scripts/check_skill_gate_controls.mjs",
    "factory:production-pass-status": "node generator/scripts/lib/production-pass-receipt.mjs",
    "factory:production-pass-receipt-qa": "node generator/scripts/production-pass-receipt-qa.mjs",
    "factory:skill-task-gate-qa": "node ../scripts/skill_task_gate_qa.mjs",
    "factory:cli-parity": "node ../scripts/check_cli_parity.mjs",
    "factory:skill-task-gate-verify": "node ../scripts/skill_task_gate.mjs verify-all"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "engines": {
    "node": ">=18"
  }
}
