          "arity": 1,
          "type": "path"
        },
        "--min-stage-backgrounds": {
          "arity": 1,
          "type": "integer"
        },
        "--allow-svg-backgrounds": {
          "arity": 0
        },
        "--require-gpt-imagegen": {
          "arity": 0
        },
        "--require-imagegen-skill": {
          "arity": 0
        },
        "--port": {
          "arity": 1,
          "type": "integer"
        },
        "--viewports": {
          "arity": 1,
