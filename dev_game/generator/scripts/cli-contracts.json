          "arity": 1,
          "type": "path"
        },
        "--skip-art": {
          "arity": 0
        },
        "--from": {
          "arity": 1,
          "type": "enum",
          "enum": [
            "scaffold",
            "productionize",
            "art",
            "qa"
          ]
        },
        "--gate": {
          "arity": 1,
          "type": "enum",
          "enum": [
            "none",
